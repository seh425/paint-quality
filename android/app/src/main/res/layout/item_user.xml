<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@color/surface_muted"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/userNameText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" />
        <TextView android:id="@+id/userDetailsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" />
    </LinearLayout>
    <Button android:id="@+id/editUserButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="编辑" />
</LinearLayout>
