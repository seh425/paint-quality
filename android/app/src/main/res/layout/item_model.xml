<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@color/surface_muted"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">
    <TextView
        android:id="@+id/modelItemText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textStyle="bold" />
    <Button android:id="@+id/editModelButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="编辑" />
    <Button android:id="@+id/deleteModelButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="删除" />
</LinearLayout>
