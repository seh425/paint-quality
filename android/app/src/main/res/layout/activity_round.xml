<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_muted">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/navy"
            android:textSize="19sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/logoutButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/logout" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="20dp">
            <TextView
                android:id="@+id/userSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/workDateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="责任区域"
                android:textColor="@color/navy"
                android:textSize="13sp"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/areaSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="检查区域"
                android:textColor="@color/navy"
                android:textSize="13sp"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/checkAreaSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
            <TextView
                android:id="@+id/areasStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="选择区域后会自动保存，并在下方显示对应检查轮次"
                android:textColor="#6B7A90"
                android:textSize="12sp" />
            <Button
                android:id="@+id/sharedRecordsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shared_records" />
            <Button
                android:id="@+id/adminButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="管理员入口"
                android:visibility="gone" />
            <TextView
                android:id="@+id/roundsHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp"
                android:text="正在读取检查轮次…"
                android:textColor="@color/navy"
                android:textSize="18sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/roundsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <Button
                android:id="@+id/refreshRoundsButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="刷新检查轮次" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
